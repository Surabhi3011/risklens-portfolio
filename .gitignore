# Data: raw downloads and intermediate outputs are never committed.
# Exception: data/raw/MANIFEST.md, the record of what was downloaded and when.
/data/*
!/data/raw/
/data/raw/*
!/data/raw/MANIFEST.md

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node / web
node_modules/
web/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
